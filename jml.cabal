cabal-version:      3.4
name:               jml
version:            0.1.0.0
build-type:         Simple

executable jml
    main-is:          Main.hs
    hs-source-dirs:   src
    other-modules:    AST, Parser, Organizer, Tree, Render
    build-depends:    base >=4 && <5,
                      containers,
                      text,
                      lucid,
                      process,
                      filepath,
                      regex-tdfa
    default-language: Haskell2010





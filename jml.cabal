cabal-version:      3.4
name:               jml
version:            0.1.0.0
build-type:         Simple

library
    exposed-modules:  AST, Parser, Organizer, Tree
    hs-source-dirs:   src
    build-depends:    base >=4 && <5,
                      containers,
                      text,
                      lucid,
                      process,
                      filepath
    default-language: Haskell2010

test-suite jml-test
    type:             exitcode-stdio-1.0
    main-is:          tests.hs
    hs-source-dirs:   test
    build-depends:    base >=4 && <5,
                      jml,
                      tasty,
                      tasty-hunit
    default-language: Haskell2010

cabal-version:      3.4
name:               jml
version:            0.1.0.0
build-type:         Simple

executable jml
    main-is:          main.hs
    hs-source-dirs:   src
    other-modules:    ast, parser, organizer, tree, render
    build-depends:    base >=4 && <5,
                      containers,
                      text,
                      lucid,
                      process,
                      filepath
    default-language: haskell2010
